{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": "..",
    "outDir": "lib",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/**/*.ts",
    "../src/sim/i8051/assembler.ts",
    "../src/sim/jetson.ts",
    "../config/grading-test-suites.json"
  ],
  "exclude": ["node_modules", "lib"]
}
